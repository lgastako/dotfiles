[user]
	name = John Evans
	email = lgastako@gmail.com
[alias]
        git         = !exec git
        news        = log -p HEAD@{1}..HEAD@{0}
        pull        = pull --recurse-submodules
        u           = push
        d           = pull
        a           = add
        co          = checkout
        ci          = commit
        st          = status
        b           = branch
        r           = remote
        reb         = rebase
        pl          = pull
        pn          = pull --no-ff
        p           = push
        qc          = commit --no-verify
        qcommit     = commit --no-verify
        m           = merge
	lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr)%C(bold blue)<%an>%Creset' --abbrev-commit
[color]
        status      = auto
        diff        = auto
        branch      = auto
        interactive = auto
[core]
	excludesfile = /Users/john/dotfiles/git/gitignore
	editor = /Applications/Emacs.app/Contents/MacOS/bin/emacsclient -t
  pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true  # use n and N to move between diff sections
    dark = true      # or light = true, or omit for auto-detection
[push]
        default = upstream
[merge]
    conflictstyle = zdiff3
[difftool]
	prompt = false
[grep]
	lineNumber = true
[mergetool]
	keepBackup = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	required = true
	process = git-lfs filter-process
[init]
	defaultBranch = main
[url "git@github.com:"]
	insteadOf = https://github.com/
